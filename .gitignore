spec-gen/output/*.docx
spec-gen/output/*.pdf
spec-gen/output/assets/*.png
spec-gen/output/assets/*.drawio
spec-gen/scripts/__pycache__/

# docs/ 目录（业务项目特定内容，不属于工具包）
docs/
