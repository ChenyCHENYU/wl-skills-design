{
  "name": "@agile-team/wl-skills-design",
  "version": "0.7.0",
  "description": "产品设计 AI 技能包 — 9 条设计规范 + AI Skill 自动调度（流程图/原型标注/说明书/数据库/接口/集成评审/术语词典/变更影响分析），支持 10 种 AI 编辑器，一条命令导入设计项目",
  "main": "./bin/wl-skills-design.js",
  "bin": {
    "wl-skills-design": "bin/wl-skills-design.js"
  },
  "files": [
    "bin/",
    "files/",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "skills",
    "copilot",
    "design",
    "flowchart",
    "drawio",
    "cursor",
    "windsurf",
    "kiro",
    "claude",
    "agents",
    "product-design"
  ],
  "author": "ChenyCHENYU",
  "license": "UNLICENSED",
  "homepage": "https://github.com/ChenyCHENYU/wl-skills-design#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/wl-skills-design/issues"
  },
  "scripts": {
    "cz": "cz",
    "sync": "node scripts/sync-editors.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "node scripts/sync-editors.js --check && node scripts/check.js",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');const bin='node_modules/husky/bin.js';if(fs.existsSync('.git')&&fs.existsSync(bin))cp.execFileSync(process.execPath,[bin],{stdio:'inherit'});\""
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/wl-skills-design.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.5.4",
    "husky": "^9.1.7"
  }
}
