{
  "schemaVersion": 1,
  "package": "@agile-team/wl-skills-design",
  "routingPolicy": {
    "sourceOfTruth": ".github/skills/_manifest.json",
    "humanIndex": ".github/skills/_registry.md",
    "matchOrder": [
      "exact",
      "semantic",
      "context"
    ],
    "minimumConfidenceToRun": 70,
    "askUserBelowConfidence": 70,
    "neverRunStatuses": [
      "planned",
      "deprecated"
    ],
    "requiredCloseLoop": [
      "generate",
      "validate",
      "repair",
      "revalidate"
    ]
  },
