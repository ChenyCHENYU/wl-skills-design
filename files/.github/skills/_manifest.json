      "promptPaths": [
        "prompts/create-flowchart.prompt.md",
        "prompts/validate-flowchart.prompt.md"
      ],
      "triggers": {
        "exact": [
          "流程图",
          "泳道图",
          "泳道",
          "flowchart",
          "draw.io",
          "业务流程",
          "生产流程",
          "工作流"
        ],
        "semantic": [
          "绘制跨部门流程",
          "梳理业务流转",
          "描述流程节点和判定分支",
          "生成 drawio 文件"
