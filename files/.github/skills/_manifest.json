{
  "schemaVersion": 2,
  "package": "@agile-team/wl-skills-design",
  "routingPolicy": {
    "sourceOfTruth": ".github/skills/_manifest.json",
    "humanIndex": ".github/skills/_registry.md",
    "normalization": ["NFKC", "lowercase", "trim", "collapse-whitespace"],
    "matchMode": "phrase-boundary",
    "intentPriority": ["impact", "review", "validate", "repair", "maintain", "create"],
    "scoreWeights": {
      "exact": 60,
      "intent": 30,
      "context": 10,
      "negative": -100
    },
    "minimumScore": 70,
    "minimumMargin": 15,
    "onAmbiguous": "ask-one-question",
    "neverRunStatuses": ["planned", "deprecated"],
    "closeLoopByIntent": {
      "create": ["generate", "validate", "repair-generated", "revalidate"],
      "validate": ["validate-readonly", "report"],
      "repair": ["validate", "repair-authorized", "revalidate"],
      "review": ["review-readonly", "report"],
      "impact": ["analyze-readonly", "validate", "report"],
      "maintain": ["update-authorized", "validate", "report"]
    }
  },
  "skills": [
    {
      "id": "requirements.flowchart",
      "name": "流程图设计",
      "status": "released",
      "version": "1.1",
      "priority": 60,
      "skillPath": "requirements-flowchart/SKILL.md",
      "standardPaths": ["standards/01-flowchart.md"],
      "promptPaths": ["prompts/create-flowchart.prompt.md", "prompts/validate-flowchart.prompt.md"],
      "intents": ["create", "validate", "review", "repair"],
      "triggers": {
        "exact": ["流程图", "泳道图", "flowchart", "draw.io", "业务流程图", "流程节点"],
        "negative": ["代码流程", "算法流程", "ci workflow", "github actions"]
      },
      "context": {
        "blocking": ["流程名称或目标"],
        "optional": ["流程范围", "参与角色或泳道", "开始和结束条件", "关键活动节点"],
        "signals": ["drawio", ".drawio", "泳道", "节点", "连线"]
      },
      "outputs": ["draw.io 流程图", "流程验证报告"]
    },
