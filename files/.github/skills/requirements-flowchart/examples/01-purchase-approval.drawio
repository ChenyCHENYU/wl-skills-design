  <!-- Tab 2: 采购申请审批流程 -->
  <diagram id="caig-proc-01" name="采购申请审批流程（CAIG-A-01）">
    <mxGraphModel dx="1665" dy="849" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 外层主容器 -->
        <mxCell id="outer"
          value="&lt;p style=&quot;line-height: 130%;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;采购申请审批流程（CAIG-A-01）&lt;/font&gt;&lt;/p&gt;"
          style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=30;gradientColor=#7ea6e0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=2;"
          vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1100" height="710" as="geometry" />
        </mxCell>

        <!-- lane-a: 申请人 -->
        <mxCell id="lane-a"
          value="&lt;span style=&quot;font-size: 18px;&quot;&gt;申请人&lt;/span&gt;"
          style="swimlane;html=1;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;"
          vertex="1" parent="outer">
          <mxGeometry y="30" width="366" height="680" as="geometry" />
        </mxCell>

        <!-- lane-b: 部门主管 -->
        <mxCell id="lane-b"
          value="&lt;span style=&quot;font-size: 18px;&quot;&gt;部门主管&lt;/span&gt;"
          style="swimlane;html=1;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;"
          vertex="1" parent="outer">
          <mxGeometry y="30" width="367" height="680" as="geometry" />
        </mxCell>

        <!-- lane-c: 采购部 -->
        <mxCell id="lane-c"
          value="&lt;span style=&quot;font-size: 18px;&quot;&gt;采购部&lt;/span&gt;"
          style="swimlane;html=1;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;"
          vertex="1" parent="outer">
          <mxGeometry y="30" width="367" height="680" as="geometry" />
        </mxCell>

        <!-- ============================================================
             lane-a 节点
        ============================================================ -->

        <!-- 开始 -->
        <mxCell id="flow-start" value="开始"
