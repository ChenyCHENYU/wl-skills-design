        <!-- ============================================================
             连接线
        ============================================================ -->

        <!-- 1. start → sa1-code（vertical，lane-a） -->
        <mxCell id="e-start-sa1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="flow-start" target="sa1-code" parent="lane-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. sa1-name → sa2-code（vertical，lane-a） -->
        <mxCell id="e-sa1-sa2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="sa1-name" target="sa2-code" parent="lane-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. sa2-name → sb1-code（跨泳道 a→b，parent=outer） -->
        <mxCell id="e-sa2-sb1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="sa2-name" target="sb1-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. sb1-name → dec1（vertical，lane-b） -->
        <mxCell id="e-sb1-dec1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="sb1-name" target="dec1" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. dec1(否) → sb2-code（vertical，lane-b） -->
        <mxCell id="e-dec1-sb2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="dec1" target="sb2-code" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="否" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="e-dec1-sb2">
          <mxGeometry x="-0.2" y="-1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- 6. dec1(是) → sc1-code（跨泳道 b→c，parent=outer） -->
        <mxCell id="e-dec1-sc1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="dec1" target="sc1-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="是" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="e-dec1-sc1">
          <mxGeometry x="-0.2" y="-1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- 7. sb2-name → sa2-code（跨泳道 b→a 反向，parent=outer）
             outer本地坐标：sb2-name中心y=477，sa2-code中心y=236 -->
        <mxCell id="e-sb2-sa2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="sb2-name" target="sa2-code" parent="outer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="477" />
              <mxPoint x="10" y="236" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. sc1-name → sc2-code（vertical，lane-c） -->
        <mxCell id="e-sc1-sc2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="sc1-name" target="sc2-code" parent="lane-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. sc2-name → sc3-code（vertical，lane-c） -->
        <mxCell id="e-sc2-sc3"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="sc2-name" target="sc3-code" parent="lane-c">
