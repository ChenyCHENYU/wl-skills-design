          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sa2-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;销售人员&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sa2-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
        </mxCell>

        <!-- 订单数据文档（产生于 sa2，置于右侧，不接入主流程线） -->
        <mxCell id="doc-order" value="系统订单数据"
