          vertex="1" parent="outer">
          <mxGeometry y="30" width="367" height="670" as="geometry" />
        </mxCell>

        <!-- ============================================================
             lane-a 节点
        ============================================================ -->

        <!-- 开始 -->
        <mxCell id="flow-start" value="开始"
