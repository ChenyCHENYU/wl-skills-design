        </mxCell>
        <mxCell id="sc3-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SALE-E-07&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="sc3-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <mxCell id="sc3-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;更新发货状态&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="sc3-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc3-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;物流专员&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sc3-g">
