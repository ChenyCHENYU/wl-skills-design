        <mxCell id="sc1-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SALE-E-05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="sc1-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <mxCell id="sc1-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;拣货配货&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="sc1-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc1-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;仓储人员&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sc1-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
        </mxCell>

        <!-- sc2: 发货出库 -->
        <mxCell id="sc2-g" value="" style="group" connectable="0" vertex="1" parent="lane-c">
          <mxGeometry x="145" y="425" width="76.82" height="54" as="geometry" />
        </mxCell>
        <mxCell id="sc2-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SALE-E-06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="sc2-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <mxCell id="sc2-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;发货出库&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="sc2-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc2-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;物流专员&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sc2-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
        </mxCell>

        <!-- sc3: 更新发货状态 -->
        <mxCell id="sc3-g" value="" style="group" connectable="0" vertex="1" parent="lane-c">
