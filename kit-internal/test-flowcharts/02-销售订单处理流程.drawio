        <mxCell id="sa2-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SALE-E-02&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="sa2-g">
