        <mxCell id="sa1-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;销售人员&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sa1-g">
