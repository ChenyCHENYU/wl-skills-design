        </mxCell>
        <mxCell id="sb1-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;销售主管&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sb1-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
        </mxCell>

        <!-- dec1: 是否确认? -->
        <mxCell id="dec1" value="是否确认?"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#cdeb8b;strokeColor=#36393d;fontSize=10;"
          vertex="1" parent="lane-b">
          <mxGeometry x="148" y="315" width="70" height="46" as="geometry" />
        </mxCell>

        <!-- sb2: 退回修改通知 -->
        <mxCell id="sb2-g" value="" style="group" connectable="0" vertex="1" parent="lane-b">
          <mxGeometry x="145" y="420" width="76.82" height="54" as="geometry" />
        </mxCell>
        <mxCell id="sb2-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;SALE-E-04&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="sb2-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <mxCell id="sb2-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;退回修改通知&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#36393d;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="sb2-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sb2-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;销售主管&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="sb2-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
        </mxCell>

        <!-- ============================================================
             lane-c 节点
        ============================================================ -->

        <!-- sc1: 拣货配货（同行 y=315，与 dec1 跨泳道对齐） -->
        <mxCell id="sc1-g" value="" style="group" connectable="0" vertex="1" parent="lane-c">
