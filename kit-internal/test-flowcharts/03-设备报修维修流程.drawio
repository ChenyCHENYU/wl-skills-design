        <mxCell id="ed1-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;EQPT-A-01&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="ed1-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <!-- name层使用 shape=process 表示子流程引用 -->
        <mxCell id="ed1-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;技术诊断分析&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="ed1-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
