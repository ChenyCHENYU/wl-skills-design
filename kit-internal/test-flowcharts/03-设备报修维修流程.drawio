        <mxCell id="ec3-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;EQPT-E-06&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="ec3-g">
