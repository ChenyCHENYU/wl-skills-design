        </mxCell>

        <!-- ============================================================
             连接线
             所有规则：
             - 同泳道：source=name层，target=code层，parent=泳道id
             - 跨泳道：source=name层，target=code层，parent=outer
             - 向左跨泳道：exitX=0, entryX=1
             - 向右跨泳道：exitX=1, entryX=0
        ============================================================ -->

        <!-- 1. start → ea1-code（vertical，lane-a） -->
        <mxCell id="e-start-ea1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="flow-start" target="ea1-code" parent="lane-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. ea1-name → ea2-code（vertical，lane-a） -->
        <mxCell id="e-ea1-ea2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="ea1-name" target="ea2-code" parent="lane-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. ea2-name → eb1-code（跨泳道 a→b，parent=outer） -->
        <mxCell id="e-ea2-eb1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="ea2-name" target="eb1-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. eb1-name → eb2-code（vertical，lane-b） -->
        <mxCell id="e-eb1-eb2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="eb1-name" target="eb2-code" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. eb2-name → ec1-code（跨泳道 b→c，parent=outer） -->
        <mxCell id="e-eb2-ec1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="eb2-name" target="ec1-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. ec1-name → ec2-code（vertical，lane-c） -->
        <mxCell id="e-ec1-ec2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="ec1-name" target="ec2-code" parent="lane-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. ec2-name → ec3-code（vertical，lane-c） -->
        <mxCell id="e-ec2-ec3"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="ec2-name" target="ec3-code" parent="lane-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. ec3-name → eb3-code（跨泳道 c→b 向左，parent=outer）
             两节点同行 y=555，水平连接
             outer本地坐标：ec3-name左边x=365+365+144=874，中心y=30+555+12+15=612
             eb3-code右边x=365+144+76.82=585.82，中心y=30+555+6=591 -->
        <mxCell id="e-ec3-eb3"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="ec3-name" target="eb3-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. eb3-name → dec1（vertical，lane-b） -->
        <mxCell id="e-eb3-dec1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="eb3-name" target="dec1" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. dec1(是) → eb4-code（vertical，lane-b） -->
        <mxCell id="e-dec1-eb4"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="dec1" target="eb4-code" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="是" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="e-dec1-eb4">
          <mxGeometry x="-0.2" y="-1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- 11. eb4-name → flow-end（vertical，lane-b） -->
        <mxCell id="e-eb4-end"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="eb4-name" target="flow-end" parent="lane-b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 12. dec1(否) → ed1-code（跨泳道 b→d 跳过c，parent=outer）
             dec1右侧 → ed1-code左侧；两节点同行 y=665 -->
        <mxCell id="e-dec1-ed1"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="dec1" target="ed1-code" parent="outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell value="否" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" connectable="0" vertex="1" parent="e-dec1-ed1">
          <mxGeometry x="-0.2" y="-1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- 13. ed1-name → ed2-code（vertical，lane-d） -->
        <mxCell id="e-ed1-ed2"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="ed1-name" target="ed2-code" parent="lane-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 14. ed2-name → flow-end-d（vertical，lane-d） -->
        <mxCell id="e-ed2-end"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
          edge="1" source="ed2-name" target="flow-end-d" parent="lane-d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
