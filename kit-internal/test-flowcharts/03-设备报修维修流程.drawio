        <mxCell id="ed2-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;出具维修方案&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="ed2-g">
