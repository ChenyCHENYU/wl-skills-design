          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ec3-dept" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;维修班长&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;verticalAlign=middle;" vertex="1" parent="ec3-g">
          <mxGeometry y="42" width="76.82" height="12" as="geometry" />
