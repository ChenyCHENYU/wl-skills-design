        </mxCell>
        <mxCell id="ec2-code" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;EQPT-E-05&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="ec2-g">
          <mxGeometry width="76.82" height="12" as="geometry" />
        </mxCell>
        <mxCell id="ec2-name" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;现场检修&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="ec2-g">
          <mxGeometry y="12" width="76.82" height="30" as="geometry" />
